# Application / browser build
APP_ENV=development
APP_NAME=DentalVoice AI
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
STRICT_AUTH_MODE=false

# Persistent services; replace example passwords in private environment configuration
POSTGRES_DB=dentalvoice
POSTGRES_USER=dentalvoice
POSTGRES_PASSWORD=supersecret
DATABASE_URL=postgresql+psycopg://dentalvoice:supersecret@postgres:5432/dentalvoice
REDIS_URL=redis://redis:6379/0
# Optional concurrency tests: must point to a DISPOSABLE database with empty public schema
TEST_POSTGRES_URL=postgresql+psycopg://dentalvoice:supersecret@localhost:5432/dentalvoice_test

# Retell: webhook-badged API key, used for raw-body signature verification.
# No Retell secret is exposed through NEXT_PUBLIC_*.
RETELL_API_KEY=dev-retell-key
RETELL_AGENT_ID=agent_demo_001
RETELL_FUNCTION_RATE_LIMIT=120
# RETELL_WEBHOOK_SECRET is legacy/unused; signatures use RETELL_API_KEY.

# Local demo only; production compose disables seeding and enforces authentication.
DEMO_SEED_ENABLED=true
DEMO_ADMIN_EMAIL=admin@harbordentaldemo.local
DEMO_ADMIN_PASSWORD=AdminPass123!
